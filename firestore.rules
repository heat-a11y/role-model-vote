rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        // >>> CHANGE THIS to the email address of the master/teacher account <<<
        function ADMIN_EMAIL() {
            return 'admin@example.com';
        }

        function signedIn() {
            return request.auth != null;
        }

        // The master signs in with email + password, so Firestore can tell it
        // apart from the anonymous class laptops. Only the master can change
        // the ballot, the class list, or clear the votes.
        function isAdmin() {
            return signedIn() && request.auth.token.email == ADMIN_EMAIL();
        }

        match /polls/{pollId} {

            function isOpen() {
                return resource.data.active == true;
            }

            function onlyCountersChanged() {
                return request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly(['totalVotes', 'options', 'classes']);
            }

            function exactlyOneMoreVote() {
                return request.resource.data.totalVotes
                    == resource.data.totalVotes + 1;
            }

            allow read: if signedIn();

            allow create: if isAdmin();

            // A class laptop may only nudge the counters by one, and only
            // while the vote is open. It cannot rename candidates, retitle the
            // ballot, change the class list, or clear votes.
            allow update: if isAdmin() || (
                signedIn()
                && isOpen()
                && request.resource.data.active == true
                && onlyCountersChanged()
                && exactlyOneMoreVote()
            );

            allow delete: if isAdmin();

            // One signed record per vote. This is the audit trail that lets the
            // dashboard prove the live counters match the votes actually cast.
            match /votes/{voteId} {
                allow read: if signedIn();
                allow create: if signedIn()
                    && get(/databases/$(database)/documents/polls/$(pollId)).data.active == true
                    && request.resource.data.keys().hasOnly([
                        'optionIndex', 'optionId', 'optionText', 'classKey', 'at'
                    ]);
                allow update, delete: if isAdmin();
            }
        }
    }
}
